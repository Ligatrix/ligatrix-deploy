# Copy to compose/.env and replace every value marked CHANGE_ME.
# compose/.env is ignored by git: never commit the real file.

# Image tag for the application build.
APP_IMAGE=reference-app:1.0.0
LOG_LEVEL=info

# Postgres. Use a long random password: openssl rand -hex 32
# (hex keeps it safe to embed in the DATABASE_URL the app receives).
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME

# Host ports published by nginx.
HTTP_PORT=80
HTTPS_PORT=443
